# Server-only upstream used by the same-origin /api gateway.
API_BASE_URL=http://localhost:3001

# Sentry error tracking is OFF BY DEFAULT: no client is created and nothing is
# sent until a DSN is set (README "Telemetry", docs/observability.md). Reports
# never carry document text, bodies, cookies, auth headers or emails;
# community installs also drop machine names, user ids, headers, breadcrumbs
# and file paths. NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time; the SENTRY_* ones are read by the Next server at runtime. Set
# SENTRY_DSN to report to your own project, or SENTRY_DISABLED=true to stop
# server and browser forwarding even with one. NEXT_PUBLIC_SENTRY_DISABLED/DSN
# are defaults for the server/tunnel when the matching runtime setting is
# empty; the browser SDK always sends through the tunnel.
NEXT_PUBLIC_SENTRY_DISABLED=false
NEXT_PUBLIC_SENTRY_INSTALL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DISABLED=false
SENTRY_INSTALL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Source-map upload for readable production stack traces; all three required.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
